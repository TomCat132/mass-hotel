<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.finetool.hotel.mapper.ChatMessageMapper">
    
    <select id="findNewMessage" resultType="cn.finetool.common.po.ChatMessage">
        SELECT *
        FROM tb_chat_message
        WHERE chat_id = #{chatId}
        ORDER BY sender_time DESC
        LIMIT 1
    </select>
</mapper>